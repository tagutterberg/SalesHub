# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bunker_management
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bunker_management

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=26214400

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SECURE=false
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Bunker Management System
REPLY_TO_EMAIL=your-email@gmail.com

# SendGrid Configuration (Optional)
USE_SENDGRID=false
SENDGRID_API_KEY=

# Security
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cron Jobs (set to false to disable scheduled tasks)
ENABLE_CRON=true
